          <Text style={{ fontSize: 58, fontWeight: 'bold', color: '#1E4FA8' }}>≥70%</Text>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>一次成功率</Text>
          <Text style={{ fontSize: 15, color: '#4A5568' }}>代码首次执行即成功占比</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 22, flex: 1 }}>
        <Box style={{ flex: 1, background: '#F0F5FC', borderRadius: 10, padding: '24px 26px', justifyContent: 'center', gap: 8 }}>
          <Text style={{ fontSize: 58, fontWeight: 'bold', color: '#1E4FA8' }}>≥85%</Text>
          <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>调试后完成率</Text>
          <Text style={{ fontSize: 15, color: '#4A5568' }}>经自动调试后的任务完成占比</Text>
