<Slide style={{ background: '#FFFFFF', padding: '36px 56px' }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, marginBottom: 14 }}>
    <Box style={{ width: 6, height: 32, background: '#1E4FA8' }} />
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1A2230' }}>系统架构</Text>
    <Text style={{ fontSize: 16, color: '#8B97A8' }}>前后端分离 B/S 架构 · 可插拔执行后端</Text>
  </Box>
  <Box style={{ flex: 1, justifyContent: 'center', alignItems: 'center' }}>
    <svg width={1150} height={580} viewBox='0 0 1150 580'>
      {/* 前端层 */}
      <rect x='175' y='18' width='800' height='104' rx='10' fill='#F0F5FC' stroke='#1E4FA8' strokeWidth='2' />
      <text x='575' y='48' textAnchor='middle' fontSize='20' fontWeight='bold' fill='#0E3F8C'>前端 React（Vite + Ant Design）</text>
      <rect x='205' y='62' width='220' height='42' rx='6' fill='#1E4FA8' />
      <text x='315' y='88' textAnchor='middle' fontSize='15' fill='#FFFFFF'>对话输入 / 多轮澄清</text>
      <rect x='465' y='62' width='220' height='42' rx='6' fill='#1E4FA8' />
      <text x='575' y='88' textAnchor='middle' fontSize='15' fill='#FFFFFF'>地图 Leaflet</text>
      <rect x='725' y='62' width='220' height='42' rx='6' fill='#1E4FA8' />
      <text x='835' y='88' textAnchor='middle' fontSize='15' fill='#FFFFFF'>图表 ECharts</text>

      {/* 前后端箭头 */}
      <line x1='575' y1='122' x2='575' y2='158' stroke='#1E4FA8' strokeWidth='2' />
      <polygon points='570,158 580,158 575,168' fill='#1E4FA8' />
      <text x='592' y='145' fontSize='14' fill='#4A5568'>HTTP / JSON</text>

      {/* 后端层 */}
      <rect x='175' y='170' width='800' height='220' rx='10' fill='#FFFFFF' stroke='#1E4FA8' strokeWidth='2' />
      <text x='575' y='200' textAnchor='middle' fontSize='20' fontWeight='bold' fill='#0E3F8C'>后端 FastAPI（:8010）</text>
      <rect x='205' y='218' width='220' height='92' rx='8' fill='#E8EFF8' stroke='#3D7BD9' strokeWidth='1' />
      <text x='315' y='248' textAnchor='middle' fontSize='16' fontWeight='bold' fill='#1A2230'>intent 意图解析</text>
      <text x='315' y='274' textAnchor='middle' fontSize='13' fill='#4A5568'>自然语言 → 结构化参数</text>
      <rect x='465' y='218' width='220' height='92' rx='8' fill='#E8EFF8' stroke='#3D7BD9' strokeWidth='1' />
      <text x='575' y='248' textAnchor='middle' fontSize='16' fontWeight='bold' fill='#1A2230'>orchestrator 编排</text>
      <text x='575' y='274' textAnchor='middle' fontSize='13' fill='#4A5568'>LangGraph 生成→执行→调试</text>
      <rect x='725' y='218' width='220' height='92' rx='8' fill='#E8EFF8' stroke='#3D7BD9' strokeWidth='1' />
      <text x='835' y='244' textAnchor='middle' fontSize='16' fontWeight='bold' fill='#1A2230'>execution 可插拔</text>
      <rect x='740' y='258' width='90' height='36' rx='5' fill='#1E4FA8' />
      <text x='785' y='281' textAnchor='middle' fontSize='13' fill='#FFFFFF'>offline</text>
      <rect x='840' y='258' width='90' height='36' rx='5' fill='#3D7BD9' />
      <text x='885' y='281' textAnchor='middle' fontSize='13' fill='#FFFFFF'>gee</text>

      {/* 后端模块间箭头 */}
      <line x1='425' y1='264' x2='463' y2='264' stroke='#1E4FA8' strokeWidth='2' />
      <polygon points='463,259 463,269 473,264' fill='#1E4FA8' />
      <line x1='685' y1='264' x2='723' y2='264' stroke='#1E4FA8' strokeWidth='2' />
      <polygon points='723,259 723,269 733,264' fill='#1E4FA8' />

      {/* 后端到外部箭头 */}
      <line x1='320' y1='390' x2='320' y2='436' stroke='#1E4FA8' strokeWidth='2' />
      <polygon points='315,436 325,436 320,446' fill='#1E4FA8' />
      <line x1='835' y1='390' x2='835' y2='436' stroke='#1E4FA8' strokeWidth='2' />
      <polygon points='830,436 840,436 835,446' fill='#1E4FA8' />

      {/* 外部服务层 */}
      <rect x='180' y='448' width='280' height='76' rx='10' fill='#E8EFF8' stroke='#3D7BD9' strokeWidth='1' />
      <text x='320' y='480' textAnchor='middle' fontSize='18' fontWeight='bold' fill='#0E3F8C'>DeepSeek API</text>
      <text x='320' y='506' textAnchor='middle' fontSize='13' fill='#4A5568'>代码生成 · 意图解析 · 修复</text>
      <rect x='690' y='448' width='280' height='76' rx='10' fill='#E8EFF8' stroke='#3D7BD9' strokeWidth='1' />
      <text x='830' y='480' textAnchor='middle' fontSize='18' fontWeight='bold' fill='#0E3F8C'>Google Earth Engine</text>
      <text x='830' y='506' textAnchor='middle' fontSize='13' fill='#4A5568'>真实云端计算（待凭据接入）</text>
    </svg>
  </Box>
</Slide>
