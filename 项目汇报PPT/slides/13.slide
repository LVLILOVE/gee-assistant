<Slide style={{ background: '#FFFFFF', padding: '40px 56px' }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, marginBottom: 18 }}>
    <Box style={{ width: 6, height: 32, background: '#1E4FA8' }} />
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#1A2230' }}>难点、借鉴与展望</Text>
  </Box>
  <Box style={{ flexDirection: 'row', flex: 1, gap: 32 }}>
    <Box style={{ flex: 3, gap: 16 }}>
      <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0E3F8C' }}>难点与应对</Text>
      {[
        { d: 'GEE 国内网络不可达', r: '可插拔后端：真实 GEE 与离线样例一键切换', s: '已闭环' },
        { d: 'LLM 代码一次成功率', r: 'RAG 知识库 + 任务模板 + 自动调试重试', s: '已闭环' },
        { d: '公网安全与额度滥用', r: '全接口鉴权 + 三处漏洞修复 + 四层任务配额', s: '已闭环' },
      ].map((x, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#F7F9FC', border: '1px solid #D6DCE5', borderRadius: 10, padding: '16px 20px' }}>
          <Box style={{ width: 34, height: 34, background: '#D9534F', borderRadius: 6, justifyContent: 'center', alignItems: 'center' }}>
            <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>{i + 1}</Text>
          </Box>
          <Box style={{ flex: 1, gap: 4 }}>
            <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#1A2230' }}>{x.d}</Text>
            <Text style={{ fontSize: 16, color: '#4A5568' }}>应对：{x.r}</Text>
          </Box>
          <Box style={{ background: '#E3F3EC', borderRadius: 6, padding: '4px 12px' }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#1D9E75' }}>{x.s}</Text>
          </Box>
        </Box>
      ))}
    </Box>
    <Box style={{ flex: 2, gap: 18 }}>
      <Box style={{ background: '#F0F5FC', borderRadius: 10, border: '1px solid #D6DCE5', padding: '20px 22px', gap: 12 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>借鉴 Earth Agent</Text>
        {['Ask / Do 咨询执行双模式', 'Custom Instructions 偏好设置', 'Agent Profiles 助手画像', 'geeDocs 数据集知识库'].map((t, i) => (
          <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ width: 8, height: 8, borderRadius: 4, background: '#1E4FA8' }} />
            <Text style={{ fontSize: 16, color: '#1A2230' }}>{t}</Text>
          </Box>
        ))}
      </Box>
      <Box style={{ background: '#F7F9FC', borderRadius: 10, border: '1px solid #D6DCE5', padding: '20px 22px', gap: 10 }}>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0E3F8C' }}>展望 Roadmap</Text>
        <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.7 }}>
          近期：固定评测集复核指标 · 移动端适配 · 报告导出扩展为 PDF
        </Text>
        <Text style={{ fontSize: 16, color: '#4A5568', lineHeight: 1.7 }}>
          长期：MCP Server 化 · 多场景扩展（ArcGIS / 无人机 / 灾害评估）
        </Text>
      </Box>
    </Box>
  </Box>
</Slide>
