# 复制本文件为 .env 并填入真实值
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 执行后端：offline（离线兜底，无需 GEE）| gee（真实 Earth Engine）
EXECUTION_BACKEND=offline

# ---- GEE 凭据（切到 gee 后端前必须配好，详见 docs/GEE凭据配置指南.md）----
# 云项目 ID（注册 Earth Engine 时创建的那个项目）
GEE_PROJECT=
# 出网代理：本机无法直连 Google 时填写，例如 http://127.0.0.1:7890
GEE_PROXY=
# 方式一（推荐）：直接用服务账号 JSON 文件
GEE_SERVICE_ACCOUNT_JSON=
# 方式二：加密凭据库（tools/gee_doctor.py --import-sa 生成）
GEE_CREDENTIALS_ENC=data/credentials/gee.enc
# 方式三：个人 OAuth 凭据路径（留空则用默认 ~/.config/earthengine/credentials）
GEE_OAUTH_CREDENTIALS=
# 单次 GEE 执行的硬超时（秒）。真实 Sentinel-2 全年合成+统计常需数分钟，建议 420
GEE_TIMEOUT=420
# 网络抖动（代理节点不稳）时的自动重试次数
GEE_NET_RETRIES=3

# 自动调试最大重试次数
MAX_RETRIES=3

# ---- 访问控制 ----
# 只要服务暴露在公网（cpolar / 任何反向代理）就必须为 true，
# 否则任何人拿到 URL 都能提交任务、消耗 DeepSeek 与 GEE 额度。
AUTH_ENABLED=true
# 是否允许自助注册。建议：注册完自己的账号后改为 false，关掉公网注册入口
ALLOW_REGISTRATION=true
# 会话有效期（小时），默认 7 天
SESSION_TTL_HOURS=168

# 预置管理员（可选，强烈建议公网部署时启用）。
# 不填也不影响使用，但那样「第一个注册的人就是管理员」——服务在公网时
# 谁先访问谁就能拿到管理员，属于竞态。填了可在启动时就确定归属。
# 登录后可在页面右上角改密码。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 后端服务端口
BACKEND_PORT=8010
